# =========================================================================
# AgriHub Environment Configuration
# =========================================================================

# Node API Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=agrihub_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# -------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (for client-side or anon operations)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Key (secret key with full database access, keep private)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Direct PostgreSQL Connection String (Optional, for direct migrations or tools)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000
